generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id              String    @id @default(uuid())
  name            String
  cnpj            String?   @unique
  plan            PlanTier  @default(TIER_I)
  status          CompanyStatus @default(TRIAL)
  planExpiresAt   DateTime?
  maxEmployees    Int       @default(10)
  asaasCustomerId String?
  settings        Json?
  trialUsed       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  checkIns        CheckIn[]
  users           User[]
  subscriptions   Subscription[]
  invites         InviteToken[]
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String
  role           UserRole  @default(EMPLOYEE)
  cpf            String?   @unique
  faceDescriptor Json?
  companyId      String
  enterpriseId   String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  checkIns       CheckIn[]
  company        Company   @relation(fields: [companyId], references: [id])
}

model CheckIn {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  type      CheckInType
  latitude  Float
  longitude Float
  address   String?
  userId    String
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
}

model Subscription {
  id                    String      @id @default(uuid())
  companyId             String
  company               Company     @relation(fields: [companyId], references: [id])
  planTier              PlanTier
  price                 Decimal     @db.Decimal(10, 2)
  status                String
  asaasSubscriptionId   String?
  startedAt             DateTime    @default(now())
  expiresAt             DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime    @default(now())

  @@index([companyId])
  @@index([status])
}

model InviteToken {
  id        String    @id @default(uuid())
  email     String
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  role      UserRole  @default(EMPLOYEE)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId])
  @@index([email])
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String
  companyId   String
  action      String
  entity      String
  entityId    String?
  oldData     Json?
  newData     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

enum UserRole {
  MASTER
  ENTERPRISE_ADMIN
  EMPLOYEE
}

enum PlanTier {
  TIER_I
  TIER_II
  TIER_III
  ENTERPRISE_CUSTOM
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CheckInType {
  ENTRY
  LUNCH_START
  LUNCH_END
  EXIT
}