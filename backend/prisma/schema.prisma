generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id              String         @id @default(uuid())
  name            String
  cnpj            String         @unique
  plan            PlanTier       @default(TIER_I)
  status          CompanyStatus  @default(TRIAL)
  planExpiresAt   DateTime?
  maxEmployees    Int            @default(10)
  asaasCustomerId String?
  settings        Json?
  trialUsed       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  checkIns        CheckIn[]
  users           User[]
  subscriptions   Subscription[]
  invites         InviteToken[]
  justificativas  Justificativa[]
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  password          String
  role              UserRole           @default(EMPLOYEE)
  cpf               String?            @unique
  faceDescriptor    Json?
  companyId         String
  status            UserStatus         @default(ACTIVE)
  deactivatedAt     DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  checkIns          CheckIn[]
  company           Company            @relation(fields: [companyId], references: [id])
  inviteTokenUsages InviteTokenUsage[]
  consentimentos    Consentimento[]
  justificativas    Justificativa[]
}

model CheckIn {
  id            String      @id @default(uuid())
  nsr           Int
  ano           Int
  createdAt     DateTime    @default(now())
  type          CheckInType
  latitude      Float
  longitude     Float
  address       String?
  employerCnpj  String
  userId        String
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([companyId, nsr, ano])
  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, nsr, ano])
}

model Subscription {
  id                  String    @id @default(uuid())
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  planTier            PlanTier
  price               Decimal   @db.Decimal(10, 2)
  status              String
  asaasSubscriptionId String?
  startedAt           DateTime  @default(now())
  expiresAt           DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime  @default(now())

  @@index([companyId])
  @@index([status])
}

model InviteToken {
  id          String             @id @default(uuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id])
  token       String             @unique
  maxUses     Int?
  currentUses Int                @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime           @default(now())
  usedByUsers InviteTokenUsage[]

  @@index([companyId])
}

model InviteTokenUsage {
  id            String      @id @default(uuid())
  inviteTokenId String
  inviteToken   InviteToken @relation(fields: [inviteTokenId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([inviteTokenId, userId])
  @@index([inviteTokenId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

enum UserRole {
  MASTER
  ENTERPRISE_ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PlanTier {
  TIER_I
  TIER_II
  TIER_III
  ENTERPRISE_CUSTOM
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CheckInType {
  ENTRY
  LUNCH_START
  LUNCH_END
  EXIT
}

model Consentimento {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tipo      String   // "TERMOS_DE_USO", "POLITICA_PRIVACIDADE", "BIOMETRIA"
  versao    String   // Versão do documento aceito (ex: "1.0")
  aceite    Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@unique([userId, tipo, versao])
  @@index([userId])
}

model Justificativa {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  tipo        String
  descricao   String
  dataInicio  DateTime
  dataFim     DateTime?
  comprovante String?
  aprovado    Boolean?
  aprovadoPor String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, dataInicio])
  @@index([companyId, dataInicio])
}
