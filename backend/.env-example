PORT=
JWT_SECRET=
FRONTEND_URL=
CPF_ENCRYPTION_KEY= # hex 64 — AES-256-GCM (ex: openssl rand -hex 32)
CPF_HASH_PEPPER=    # hex 64 — Pepper distinto p/ hash CPF (ex: openssl rand -hex 32) — A5: nunca reuse CPF_ENCRYPTION_KEY
FACE_ENCRYPTION_KEY=

DATABASE_URL_DEV=

DATABASE_URL_PROD=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Asaas Payment Gateway
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=
# CNPJ da empresa master isenta — nunca cobra Asaas (14 dígitos, ex: 00000000000000)
MASTER_CNPJ=

# Certificado Digital A1 (ICP-Brasil) — para assinatura AFD/AEJ/Comprovante
# Preencha após obter seu .p12. Deixe vazio enquanto não tiver — sistema funciona sem assinatura (apenas hash).
CERT_A1_PATH=./certs/viggo-a1.p12
CERT_A1_PASSWORD=troque_aqui_sua_senha_A1
CERT_A1_BASE64=

# Backup AFD/AEJ mensal Modelo A (Art.81) — local criptografado, pronto p/ S3 futuro
# Gere com: openssl rand -hex 32
AFD_BACKUP_KEY=
AFD_BACKUP_DIR=./backups
# S3 futuro (opcional): quando preencher, upload passa a ir para S3 sem mudar código
# S3_BUCKET=viggo-backups
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── E-mail Transacional (Resend) ─────────────────────────────
# Gere em https://resend.com/api-keys
RESEND_API_KEY=
# Remetente verificado no Resend (precisa verificar domínio viggo.com.br)
EMAIL_FROM="Viggo <noreply@viggo.com.br>"
EMAIL_REPLY_TO="suporte@viggo.com.br"
# Flag global — false desativa todos os envios (útil em TEST)
EMAIL_ENABLED=true
# Se true, não chama Resend; apenas loga HTML no pino (dev)
EMAIL_PREVIEW=false
# Em ambiente de teste/homolog, força todos os envios para este endereço
# Deixe vazio em produção para enviar ao destinatário real
EMAIL_TEST_TO=dragonbolad@gmail.com
# Flags por template (opcional, default true se omitido)
EMAIL_INVITE_ENABLED=false